<table border = 1>
    <thead>
        <tr>
            <th> id </th>
            <th> username </th>
            <th> email </th>
        </tr>
    </thead>
    {% for i in authors %}
        <tr>
            <td>{{ i.id }}</td>
            <td>{{ i.username }}</td>
            <td>{{ i.email }}</td>
        </tr>
    {% endfor %}
</table>